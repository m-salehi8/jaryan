# ─────────────────────────────────────────────────────────────
# Jaryan — production environment template
# ─────────────────────────────────────────────────────────────
# Copy to .env and replace every CHANGE_ME before deploying:
#
#   cp .env.example .env
#
# Generate strong values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# .env is gitignored — never commit real secrets.

# ── Django ──
# Used to sign sessions and cookies. Rotating it logs everyone out.
SECRET_KEY=CHANGE_ME
# Never enable DEBUG on a public server: it leaks settings and stack traces.
DEBUG=False
# Comma-separated hosts/IPs Django will answer for. Set this to your server IP.
ALLOWED_HOSTS=CHANGE_ME_SERVER_IP,localhost,127.0.0.1
# Comma-separated origins allowed to call the API from a browser.
# Must include scheme and port, e.g. http://203.0.113.10
CORS_ORIGINS=http://CHANGE_ME_SERVER_IP
# Origins trusted for unsafe methods (POST/PUT) in the Django admin.
CSRF_TRUSTED_ORIGINS=http://CHANGE_ME_SERVER_IP

# ── Auth ──
# Signs API access tokens; independent of SECRET_KEY.
JWT_SECRET=CHANGE_ME

# ── PostgreSQL ──
DB_NAME=jaryan
DB_USER=jaryan
DB_PASS=CHANGE_ME
DB_HOST=db
DB_PORT=5432

# ── MongoDB ──
MONGO_USER=jaryan
MONGO_PASSWORD=CHANGE_ME
MONGO_DB_NAME=jaryan

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME

# ── AI provider ──
# Optional. The AI workflow generator is disabled without it.
EMERGENT_LLM_KEY=

# ── Initial admin ──
# Used once by `docker compose exec backend python manage.py createsuperuser`.
DJANGO_SUPERUSER_EMAIL=admin@jaryan.ir
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
